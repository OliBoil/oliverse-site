---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import NoteCard from '../../components/NoteCard.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const notes = (await getCollection('notes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout lang="en">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow"><span class="live-dot"></span> Building in public from Barcelona</p>
      <h1>Learning how<br />technology works—with <em>AI.</em></h1>
      <p class="hero-intro">I’m Oliver, an SMIX student passionate about artificial intelligence. I explore how to turn its potential into real actions, useful projects and lessons worth sharing.</p>
      <div class="hero-actions"><a class="button primary" href="/en/projects">Explore my work <span>↗</span></a><a class="button secondary" href="/en/notes">Read the notes</a></div>
      <div class="skill-row"><span>AI &amp; automation</span><span>IT support</span><span>Systems</span><span>Networks</span></div>
    </div>
    <div class="terminal-card"><div class="terminal-bar"><span></span><span></span><span></span><b>oliver@oliverse</b></div><div class="terminal-body"><p><i>➜</i> <b>whoami</b></p><p class="terminal-output">SMIX student · IT explorer · builder</p><p><i>➜</i> <b>cat current-focus.txt</b></p><p class="terminal-output">support &amp; systems<br />automation &amp; practical tools<br />learning by doing</p><p><i>➜</i> <b>status</b></p><p class="terminal-output success">● ready for the next challenge</p><p class="cursor-line"><i>➜</i> <span class="cursor"></span></p></div></div>
  </section>
  <section class="stats shell"><div><strong>Curiosity</strong><span>ask how it works</span></div><div><strong>Action</strong><span>turn ideas into trials</span></div><div><strong>Clarity</strong><span>share what I learn</span></div></section>
  <section class="ai-feature shell"><div class="ai-orbit" aria-hidden="true"><span>AI</span><i></i><i></i><i></i></div><div><p class="eyebrow">Flagship project</p><h2>Coco: personal AI with a purpose.</h2><p>After discovering that AI could go beyond answering questions and act through real tools, I wanted to build an assistant of my own. Coco brings automation, voice, organisation, research and learning together in a project that grows with me.</p><a class="text-link" href="/en/projects/coco">Discover the project →</a></div></section>
  <section class="section shell"><div class="heading-row"><SectionHeading eyebrow="Selected work" title="Projects with a purpose." copy="Small, practical builds that turn new skills into something useful." /><a class="text-link desktop-link" href="/en/projects">All projects →</a></div><div class="project-grid mobile-slider">{projects.slice(0, 2).map((project) => <ProjectCard slug={project.id} {...project.data} lang="en" />)}</div></section>
  <section class="section notes-section"><div class="shell"><div class="heading-row"><SectionHeading eyebrow="Learning log" title="Fresh from the field." copy="What I build, what breaks and what I learn along the way." /><a class="text-link desktop-link" href="/en/notes">All notes →</a></div><div class="note-grid mobile-slider">{notes.slice(0, 2).map((note) => <NoteCard slug={note.id} {...note.data} lang="en" />)}</div></div></section>
  <section class="lab-teaser shell"><div><p class="eyebrow">Oliverse Lab</p><h2>Small ideas. Real learning.</h2><p>A space for prototypes, AI experiments and mini-projects worth testing before they grow into something bigger.</p></div><a class="button secondary" href="/en/lab">Enter the lab <span>↗</span></a></section>
  <section class="cta shell"><div><p class="eyebrow">Still curious</p><h2>Let’s build the next thing.</h2></div><a class="button primary" href="/en/contact">Get in touch <span>↗</span></a></section>
</BaseLayout>
